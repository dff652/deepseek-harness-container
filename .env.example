# Copy to a deployment-owned env file outside Git and fill every blank value.
# This example deliberately contains no real IP, host path, password or hash.

DSH_IMAGE=local/dsh:0.1.1-rc.1-arm64
DSH_LAN_IP=
DSH_WORKSPACE=
DSH_CADDY_USERNAME=dsh-admin
# Generate with `caddy hash-password`; in the deployment .env, wrap a bcrypt
# value containing dollar signs in single quotes so Compose treats it literally.
DSH_CADDY_PASSWORD_HASH=
