# Copy to a deployment-owned env file outside Git and fill every blank value.
# This example deliberately contains no real IP, host path, password or hash.

DSH_IMAGE=local/dsh:0.1.1-rc.2-arm64
# Portable offline reference restored by caddy-2.11.4-arm64.tar. The locked
# registry child digest remains in image-lock.json; do not invent another tag.
CADDY_IMAGE=caddy:dsh-offline-2.11.4-arm64-1172d4213087
DSH_LAN_IP=
# Host-side HTTPS port. Keep 443 when available; choose e.g. 8443 when host 443
# is occupied or an isolated parallel candidate needs a distinct URL. The
# container listener remains 443 and port 3080 is never published.
DSH_HTTPS_PORT=443
# Exact browser authority: use the bare IP with host port 443, or IP:port for
# a non-default host port (for example 192.0.2.10:8443). It must match the
# values above; do not list both forms as that would weaken same-origin checks.
DSH_EXTERNAL_AUTHORITY=
DSH_WORKSPACE=
DSH_CADDY_USERNAME=dsh-admin
# Generate with `caddy hash-password`; in the deployment .env, wrap a bcrypt
# value containing dollar signs in single quotes so Compose treats it literally.
DSH_CADDY_PASSWORD_HASH=
