# Copy outside Git and fill every blank with deployment-owned absolute values.
# This profile is a non-publishing PoC and must not replace compose.yaml in
# production until the gates in docs/haproxy-poc.md pass.

DSH_IMAGE=local/dsh:0.1.1-rc.1-arm64
DSH_PLATFORM=linux/arm64
DSH_LAN_IP=
DSH_HTTPS_PORT=443
DSH_WORKSPACE=

# Exact Docker Official Image ARM64 child. Use the AMD64 child documented in
# docs/haproxy-poc.md only with DSH_PLATFORM=linux/amd64.
HAPROXY_IMAGE=haproxy:3.4.3-alpine3.24@sha256:0fe6e31a91ad42440ceba4419694189673f9773f90b985bd883db0054a7c5259
HAPROXY_CONFIG=
HAPROXY_CERT=
