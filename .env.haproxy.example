# Copy outside Git and fill every blank with deployment-owned absolute values.
# This profile is a non-publishing PoC and must not replace compose.yaml in
# production until the gates in docs/haproxy-poc.md pass.

DSH_IMAGE=local/dsh:0.1.1-rc.2-arm64
DSH_PLATFORM=linux/arm64
DSH_LAN_IP=
# The renderer derives the one accepted browser authority from DSH_LAN_IP and
# this port: bare IP for 443, or IP:port for any non-default port.
DSH_HTTPS_PORT=443
DSH_WORKSPACE=

# Portable same-repository tag restored by the verified ARM64 archive. The
# tag suffix identifies the locked child manifest; it is intentionally a tag,
# not a digest-only reference, so a disconnected `docker load` can resolve it.
HAPROXY_IMAGE=haproxy:dsh-offline-3.4.3-arm64-0fe6e31a91ad
# For the separately verified AMD64 archive, use:
# HAPROXY_IMAGE=haproxy:dsh-offline-3.4.3-amd64-c7f5037a5673
HAPROXY_CONFIG=
HAPROXY_CERT=
